{
  "name": "@phsa.tec/design-system-react",
  "version": "1.0.0-alpha.0",
  "description": "Design system em Web Components (Lit), 100% isolado via Shadow DOM.",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "sideEffects": [
    "./dist/*/index.js",
    "./dist/chunks/*.js"
  ],
  "scripts": {
    "dev": "npm run analyze && storybook dev -p 6006",
    "analyze": "cem analyze",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-types.mjs && npm run analyze",
    "build-storybook": "npm run analyze && storybook build",
    "typecheck": "npm run analyze && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriques4nti4go/phsa-design-system.git"
  },
  "homepage": "https://github.com/henriques4nti4go/phsa-design-system#readme",
  "bugs": {
    "url": "https://github.com/henriques4nti4go/phsa-design-system/issues"
  },
  "keywords": [
    "design-system",
    "web-components",
    "lit",
    "shadow-dom",
    "tailwindcss",
    "ui-components"
  ],
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "postcss": "^8.5.30",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "rs-module-lexer": false
  },
  "customElements": "custom-elements.json"
}
